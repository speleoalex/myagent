#!/usr/bin/env python3
"""Append content to a file (creating it and parent dirs if needed)."""
import json
import sys
from pathlib import Path

args = json.loads(sys.stdin.read())
path = Path(args["path"])
content = args["content"]

try:
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as f:
        n = f.write(content)
    print(f"OK: Appended {n} chars to {path}")
except OSError as e:
    print(f"ERROR: {e}", file=sys.stderr)
    sys.exit(1)
