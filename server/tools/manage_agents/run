#!/usr/bin/env python3
"""Manage MyAgent agents: list them, or add/update one.

Operates directly on the JSON agent files under the config dir (one file per
agent, ``<config>/agents/<id>.json``) so it does not depend on the HTTP API
being reachable. Paths follow the same env overrides as the server (config.py):
  MYAGENT_CONFIG   -> config dir (default ~/myagent/config)
  MYAGENT_TOOLS    -> user tools dir (default ~/myagent/tools)
  MYAGENT_APP_DIR  -> the app's server/ dir, whose tools/ is the bundled catalog
The agent store reads files fresh on every request, so writes here take effect
immediately (no restart needed).

bundled_dir/_walk_layer/catalogue are DUPLICATED from manage_tools/run on
purpose: a copy-on-write override copies one leaf tool folder, so a module
shared by the two tools would break the moment either is edited. Behaviour must
stay aligned — tests/test_tool_catalogue_sync.py compares the code.
"""
import copy
import json
import os
import re
import sys
from pathlib import Path

# Mirrors app.storage.store._VALID_ID: ids become filenames, so keep them safe.
_VALID_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")

# An MCP tool lives on an external server the app discovers at runtime, so
# there is nothing on disk to check a grant against — only its shape.
_VALID_MCP = re.compile(r"^mcp:[^/\s:]+/(\*|[^/\s]+)$")

# The full Agent schema with defaults (mirrors app.models.Agent, same field
# order) so a written file looks exactly like one produced by the API's
# agent.model_dump(). schedule_others is defaulted here but deliberately NOT
# exposed in tool.json: it is the one escalation flag in the model — it grants
# power over OTHER agents — and an agent writing agents must not be able to
# hand it out. Set it from the UI.
_AGENT_DEFAULTS = {
    "id": "",
    "name": "",
    "description": "",
    "model_id": "default",
    "system_prompt": "",
    "tools": [],
    "max_iterations": 10,
    "max_tool_calls": 5,
    "temperature": None,
    "response_temperature": None,
    "enabled": True,
    "callable": True,
    "callable_agents": ["*"],
    "memory_enabled": False,
    "memory_threshold": 4000,
    "live": False,
    "schedule_others": False,
    "autonomous": None,
}


def myagent_home() -> Path:
    """Root of the runtime layout. Same precedence as server/app/config.py: the
    specific override wins over the common root, which wins over the default."""
    return Path(os.environ.get("MYAGENT_HOME") or (Path.home() / "myagent")).expanduser()


def config_dir() -> Path:
    return Path(os.environ.get("MYAGENT_CONFIG") or (myagent_home() / "config")).expanduser()


def tools_dir() -> Path:
    return Path(os.environ.get("MYAGENT_TOOLS") or (myagent_home() / "tools")).expanduser()


def agents_dir() -> Path:
    return config_dir() / "agents"


def slugify(text: str) -> str:
    """Same rule as the web UI (app.js): lowercase, non-alnum runs -> '-'."""
    return re.sub(r"^-|-$", "", re.sub(r"[^a-z0-9]+", "-", (text or "").lower()))


def bundled_dir() -> Path | None:
    """The app's read-only native catalog (server/tools). Located through
    MYAGENT_APP_DIR (exported by the registry to every tool subprocess); when
    absent, fall back to this script's own location, which IS the bundled
    catalog unless the user has an override copy of manage_agents."""
    app_dir = os.environ.get("MYAGENT_APP_DIR")
    root = Path(app_dir) / "tools" if app_dir else Path(__file__).resolve().parent.parent
    try:
        if not root.is_dir() or root.resolve() == tools_dir().resolve():
            return None
    except OSError:
        return None
    return root


def _walk_layer(root: Path | None) -> dict:
    """One layer's tools as id -> (folder, category). A subfolder WITHOUT a
    tool.json is a group (category); its subfolders are tools, one level deep.
    Flat tools first, so on a duplicate id within the layer the flat copy
    wins — same precedence as the server's registry."""
    out = {}
    if root is None or not root.is_dir():
        return out
    entries = sorted(e for e in root.iterdir() if e.is_dir())
    for e in entries:
        if (e / "tool.json").exists():
            out.setdefault(e.name, (e, None))
    for e in entries:
        if (e / "tool.json").exists():
            continue
        for sub in sorted(e.iterdir()):
            if sub.is_dir() and (sub / "tool.json").exists():
                out.setdefault(sub.name, (sub, e.name))
    return out


def catalogue() -> dict:
    """Every visible tool: the bundled catalog overlaid by the user dir.
    id -> dict(path=resolved folder (user copy wins), category (the bundled
    layout owns it for native tools), origin='native'|'custom',
    has_override=bool, native_path, user_path)."""
    native = _walk_layer(bundled_dir())
    user = _walk_layer(tools_dir())
    out = {}
    for tid in set(native) | set(user):
        u, ucat = user.get(tid, (None, None))
        n, ncat = native.get(tid, (None, None))
        out[tid] = {
            "path": u if u is not None else n,
            "category": ncat if n is not None else ucat,
            "origin": "native" if n is not None else "custom",
            "has_override": u is not None and n is not None,
            "native_path": n,
            "user_path": u,
        }
    return out


def parse_category_wildcard(entry: str) -> str | None:
    """``<category>/*`` -> category name, else None.

    Mirrors ToolRegistry.parse_category_wildcard: the agent file this tool
    writes is read back by that registry, so the two must agree on what
    ``<group>/*`` means. Category names share the tool-id charset (no ``:``),
    so this can never swallow an ``mcp:<server>/*`` entry."""
    if entry.endswith("/*"):
        cat = entry[:-2]
        if cat and "/" not in cat and ":" not in cat and ".." not in cat:
            return cat
    return None


def available_tools() -> tuple[list[str], dict]:
    """Every tool id an agent may reference, plus group -> its tool ids.

    BOTH LAYERS and BOTH LEVELS. Scanning only the top level of the user tools
    dir — what this did before — made every bundled tool 'unknown', so on a
    normal install (where that dir holds only the user's own tools, or nothing
    at all) agent-manager could not grant a single tool."""
    cat = catalogue()
    groups: dict[str, list[str]] = {}
    for tool_id, info in cat.items():
        if info["category"]:
            groups.setdefault(info["category"], []).append(tool_id)
    return sorted(cat), {g: sorted(v) for g, v in sorted(groups.items())}


def render_catalogue(ids: list[str], groups: dict) -> str:
    """The grantable ids, grouped. The model reads this right before retrying,
    so it has to teach the wildcard as well as list the names."""
    grouped = {t for v in groups.values() for t in v}
    lines = []
    flat = [t for t in ids if t not in grouped]
    if flat:
        lines.append(f"  (top level) {', '.join(flat)}")
    for g, members in groups.items():
        lines.append(f"  {g}/* : {', '.join(members)}")
    lines.append("  A whole group can be granted at once as '<group>/*'.")
    return "\n".join(lines)


def check_tools(requested: list) -> None:
    ids, groups = available_tools()
    known, unknown = set(ids), []
    for entry in requested:
        if not isinstance(entry, str) or not entry.strip():
            fail("'tools' must be a list of tool ids (strings).")
        entry = entry.strip()
        if entry.startswith("mcp:"):
            if not _VALID_MCP.match(entry):
                fail(f"Invalid MCP entry {entry!r}. Use 'mcp:<server>/<tool>' "
                     f"or 'mcp:<server>/*' for a whole server.")
            continue
        cat = parse_category_wildcard(entry)
        if cat is not None:
            if cat not in groups:
                fail(f"Unknown tool group {entry!r}. Groups: "
                     f"{', '.join(f'{g}/*' for g in groups) or '(none)'}")
            continue
        if entry not in known:
            unknown.append(entry)
    if unknown:
        fail(f"Unknown tool(s): {', '.join(unknown)}. Available tools:\n"
             + render_catalogue(ids, groups))


def available_models() -> list[str]:
    d = config_dir() / "models"
    if not d.is_dir():
        return []
    return sorted(f.stem for f in d.glob("*.json"))


def fail(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def do_list() -> None:
    # Plain text, one line per agent: the reader is a model, and a pretty
    # JSON dump costs tokens without adding information.
    d = agents_dir()
    lines = []
    if d.is_dir():
        for f in sorted(d.glob("*.json")):
            try:
                a = json.loads(f.read_text())
            except (json.JSONDecodeError, OSError):
                continue
            tools = ", ".join(a.get("tools") or []) or "none"
            flags = "" if a.get("enabled", True) else " (DISABLED)"
            desc = " ".join((a.get("description") or "").split())
            lines.append(f"- {a.get('id', f.stem)} — {a.get('name', '')}"
                         f" [model: {a.get('model_id', '')}] tools: {tools}{flags}"
                         + (f"\n  {desc}" if desc else ""))
    print(f"OK: {len(lines)} agent(s)")
    print("\n".join(lines))
    ids, groups = available_tools()
    if ids:
        print("Tools that can be granted:")
        print(render_catalogue(ids, groups))


def read_agent(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return None


def do_save(args: dict) -> None:
    name = (args.get("name") or "").strip()
    agent_id = (args.get("id") or "").strip() or slugify(name)
    if agent_id == "auto":
        # Reserved: the chat's automatic-agent-selection sentinel (the agents
        # API refuses it too). A real "auto" would switch that feature off.
        fail("The id 'auto' is reserved for automatic agent selection; choose another id.")
    if not agent_id:
        fail("Provide a 'name' (or an explicit 'id') to save an agent.")
    if not _VALID_ID.match(agent_id) or ".." in agent_id:
        fail(f"Invalid agent id derived: {agent_id!r}. Use letters, digits, '.', '_' or '-'.")

    # Validate requested tools against the ones actually installed.
    if "tools" in args and args["tools"] is not None:
        if not isinstance(args["tools"], list):
            fail("'tools' must be a list of tool ids.")
        check_tools(args["tools"])

    # Validate model_id when explicitly given (skip the 'default' sentinel).
    model_id = args.get("model_id")
    if model_id and model_id != "default":
        models = available_models()
        if models and model_id not in models:
            fail(f"Unknown model_id: {model_id!r}. Available models: {', '.join(models)}")

    dst = agents_dir()
    dst.mkdir(parents=True, exist_ok=True)
    path = dst / f"{agent_id}.json"
    existed = path.exists()

    copy_from = (args.get("copy_from") or "").strip()
    if existed:
        # Updating an existing agent: start from its current config.
        agent = read_agent(path) or copy.deepcopy(_AGENT_DEFAULTS)
    elif copy_from:
        # Cloning: start from the source agent's config, then apply overrides.
        base = read_agent(dst / f"{copy_from}.json")
        if base is None:
            ids = sorted(f.stem for f in dst.glob("*.json"))
            fail(f"copy_from agent not found: {copy_from!r}. Available agents: {', '.join(ids) or '(none)'}")
        agent = base
    else:
        agent = copy.deepcopy(_AGENT_DEFAULTS)

    # Backfill any missing schema fields (older files may lack newer keys).
    for k, v in _AGENT_DEFAULTS.items():
        agent.setdefault(k, v)

    agent["id"] = agent_id
    # Only overwrite fields the caller actually provided (so updates are partial).
    if name:
        agent["name"] = name
    elif not agent.get("name"):
        agent["name"] = agent_id
    for key in ("system_prompt", "description", "model_id", "enabled", "memory_enabled", "live"):
        if key in args and args[key] is not None:
            agent[key] = args[key]
    if "autonomous" in args:
        v = args["autonomous"]
        if v is not None and not isinstance(v, dict):
            fail("'autonomous' must be an object (or null for defaults).")
        agent["autonomous"] = v
    if "tools" in args and args["tools"] is not None:
        agent["tools"] = list(args["tools"])
    if "callable" in args and args["callable"] is not None:
        if not isinstance(args["callable"], bool):
            fail("'callable' must be true or false.")
        agent["callable"] = args["callable"]
    if "callable_agents" in args and args["callable_agents"] is not None:
        v = args["callable_agents"]
        if not isinstance(v, list) or any(not isinstance(x, str) for x in v):
            fail("'callable_agents' must be a list of agent ids, [\"*\"] for all, "
                 "or [] for none.")
        agent["callable_agents"] = list(v)
    # Tuning fields. temperature/response_temperature accept a number or null
    # (null = use the provider default). max_* must be positive integers.
    for key in ("temperature", "response_temperature"):
        if key in args:
            v = args[key]
            if v is not None and (isinstance(v, bool) or not isinstance(v, (int, float))):
                fail(f"'{key}' must be a number or null.")
            agent[key] = v
    for key in ("max_iterations", "max_tool_calls", "memory_threshold"):
        if key in args and args[key] is not None:
            v = args[key]
            if isinstance(v, bool) or not isinstance(v, int) or v < 1:
                fail(f"'{key}' must be a positive integer.")
            agent[key] = v

    # Atomic write with restrictive perms (matches JsonStore.save).
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(agent, ensure_ascii=False, indent=2))
    os.chmod(tmp, 0o600)
    tmp.replace(path)

    verb = "Updated" if existed else "Created"
    print(f"OK: {verb} agent '{agent['name']}' (id: {agent_id})")
    # Essentials only — echoing the whole config (system_prompt included)
    # back at the model just burns tokens.
    print(f"model: {agent.get('model_id')}; tools: "
          f"{', '.join(agent.get('tools') or []) or 'none'}; "
          f"enabled: {agent.get('enabled', True)}; "
          f"prompt: {len(agent.get('system_prompt') or '')} chars")


def main() -> None:
    try:
        args = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError as e:
        fail(f"Invalid JSON input: {e}")
    if not isinstance(args, dict):
        fail("Input must be a JSON object.")

    action = (args.get("action") or "").strip().lower()
    if action == "list":
        do_list()
    elif action in ("save", "add", "update", "upsert"):
        do_save(args)
    else:
        fail("Unknown action. Use 'list' or 'save'.")


if __name__ == "__main__":
    main()
