#!/bin/sh
# document_extract launcher.
# faster-whisper (audio transcription) lives in the app virtualenv, so this must
# run the venv's python and not whatever `python3` resolves to: with a bare
# shebang the audio path only worked when the SYSTEM python happened to have
# faster-whisper installed. Same pattern as local_search/run.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PY="$MYAGENT_APP_DIR/.venv/bin/python"
[ -x "$PY" ] || PY="$DIR/../../.venv/bin/python"
[ -x "$PY" ] || PY=python3
exec "$PY" "$DIR/extract.py"
