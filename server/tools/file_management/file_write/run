#!/usr/bin/env python3
"""Write content to a file."""
import json
import sys
from pathlib import Path

args = json.loads(sys.stdin.read())
# cwd IS the workspace, so "~/myagent/workspace/x" from the model would be read
# as a RELATIVE path and mkdir(parents=True) would materialize a directory named
# literally "~" (observed 2026-08-10: workspace/~/myagent/workspace/itinerario/).
# An unresolvable "~user" is left as typed: RuntimeError out of a tool is a
# traceback, not something the model can act on.
try:
    path = Path(args["path"]).expanduser()
except RuntimeError:
    path = Path(args["path"])
content = args["content"]

try:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    print(f"OK: Written {len(content)} chars to {path.resolve()}")
except OSError as e:
    print(f"ERROR: {e}", file=sys.stderr)
    sys.exit(1)
