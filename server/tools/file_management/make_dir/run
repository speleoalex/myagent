#!/usr/bin/env python3
"""Create a directory (and any missing parents)."""
import json
import sys
from pathlib import Path

args = json.loads(sys.stdin.read())
# cwd IS the workspace: without this a "~/..." path is taken as relative and
# creates a directory literally named "~" (see file_write for the full story).
try:
    path = Path(args["path"]).expanduser()
except RuntimeError:
    path = Path(args["path"])

try:
    path.mkdir(parents=True, exist_ok=True)
    print(f"OK: Directory ready: {path.resolve()}")
except OSError as e:
    print(f"ERROR: {e}", file=sys.stderr)
    sys.exit(1)
