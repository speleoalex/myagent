#!/usr/bin/env python3
"""Append content to a file (creating it and parent dirs if needed)."""
import json
import sys
from pathlib import Path

args = json.loads(sys.stdin.read())
# cwd IS the workspace: without this a "~/..." path is taken as relative and
# creates a directory literally named "~" (see file_write for the full story).
try:
    path = Path(args["path"]).expanduser()
except RuntimeError:
    path = Path(args["path"])
content = args["content"]

try:
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as f:
        n = f.write(content)
    print(f"OK: Appended {n} chars to {path.resolve()}")
except OSError as e:
    print(f"ERROR: {e}", file=sys.stderr)
    sys.exit(1)
