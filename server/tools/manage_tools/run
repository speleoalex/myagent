#!/usr/bin/env python3
"""Manage MyAgent tools: list, inspect, create/update, test, reset or delete.

Operates directly on the tool folders (``tool.json`` + executable ``run``) so
it does not depend on the HTTP API being reachable. Tools are an OVERLAY: the
app's bundled catalog (native tools, always present, read-only) under the user
tools dir, which holds user-created tools and local copies of edited native
tools — editing a native tool copies it first (copy-on-write), 'reset' deletes
the copy so the shipped original shows through again. Paths follow the same
env overrides as the server (config.py):
  MYAGENT_TOOLS     -> user tools dir (default ~/myagent/tools)
  MYAGENT_APP_DIR   -> app server dir; bundled catalog at $MYAGENT_APP_DIR/tools
  MYAGENT_WORKSPACE -> workspace dir  (default ~/myagent/workspace)
The registry re-scans the filesystem with mtime caching, so a tool written here
is callable immediately (no restart needed).
"""
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# Mirrors app.routers.tools._VALID_TOOL_ID: ids become directory names (and the
# function name the model calls), so keep them safe.
_VALID_TOOL_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")

# Deleting the tool that manages tools would leave the agent with no way back.
_SELF_ID = "manage_tools"

_META_DEFAULTS = {
    "name": "",
    "description": "",
    "parameters": {"type": "object", "properties": {}, "required": []},
    "timeout": 30,
    "max_output": 10000,
}

# A test run must fit inside this tool's own timeout (tool.json: 60s).
_MAX_TEST_SECONDS = 45


def myagent_home() -> Path:
    """Root of the runtime layout. Same precedence as server/app/config.py; the
    server exports the resolved paths, so this only decides what a run by hand
    from a terminal sees."""
    return Path(os.environ.get("MYAGENT_HOME") or (Path.home() / "myagent")).expanduser()


def tools_dir() -> Path:
    return Path(os.environ.get("MYAGENT_TOOLS") or (myagent_home() / "tools")).expanduser()


def bundled_dir() -> Path | None:
    """The app's read-only native catalog (server/tools). Located through
    MYAGENT_APP_DIR (exported by the registry to every tool subprocess); when
    absent, fall back to this script's own location, which IS the bundled
    catalog unless the user has an override copy of manage_tools."""
    app_dir = os.environ.get("MYAGENT_APP_DIR")
    root = Path(app_dir) / "tools" if app_dir else Path(__file__).resolve().parent.parent
    try:
        if not root.is_dir() or root.resolve() == tools_dir().resolve():
            return None
    except OSError:
        return None
    return root


def workspace_dir() -> Path:
    return Path(
        os.environ.get("MYAGENT_WORKSPACE") or (myagent_home() / "workspace")
    ).expanduser()


def fail(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def _walk_layer(root: Path | None) -> dict:
    """One layer's tools as id -> (folder, category). A subfolder WITHOUT a
    tool.json is a group (category); its subfolders are tools, one level deep.
    Flat tools first, so on a duplicate id within the layer the flat copy
    wins — same precedence as the server's registry."""
    out = {}
    if root is None or not root.is_dir():
        return out
    entries = sorted(e for e in root.iterdir() if e.is_dir())
    for e in entries:
        if (e / "tool.json").exists():
            out.setdefault(e.name, (e, None))
    for e in entries:
        if (e / "tool.json").exists():
            continue
        for sub in sorted(e.iterdir()):
            if sub.is_dir() and (sub / "tool.json").exists():
                out.setdefault(sub.name, (sub, e.name))
    return out


def catalogue() -> dict:
    """Every visible tool: the bundled catalog overlaid by the user dir.
    id -> dict(path=resolved folder (user copy wins), category (the bundled
    layout owns it for native tools), origin='native'|'custom',
    has_override=bool, native_path, user_path)."""
    native = _walk_layer(bundled_dir())
    user = _walk_layer(tools_dir())
    out = {}
    for tid in set(native) | set(user):
        u, ucat = user.get(tid, (None, None))
        n, ncat = native.get(tid, (None, None))
        out[tid] = {
            "path": u if u is not None else n,
            "category": ncat if n is not None else ucat,
            "origin": "native" if n is not None else "custom",
            "has_override": u is not None and n is not None,
            "native_path": n,
            "user_path": u,
        }
    return out


def installed_ids() -> list[str]:
    return sorted(catalogue())


def find_tool(tool_id: str) -> dict | None:
    return catalogue().get(tool_id)


def read_meta(path: Path) -> dict | None:
    try:
        return json.loads((path / "tool.json").read_text())
    except (json.JSONDecodeError, OSError):
        return None


def resolve(args: dict, *, must_exist: bool) -> tuple[str, dict | None]:
    """Validate the id and look it up in the overlay catalogue."""
    tool_id = (args.get("id") or "").strip()
    if not tool_id:
        fail("Provide the tool 'id' (its folder name, e.g. 'word_count').")
    if not _VALID_TOOL_ID.match(tool_id) or ".." in tool_id:
        fail(f"Invalid tool id: {tool_id!r}. Use letters, digits, '.', '_' or '-'.")
    info = find_tool(tool_id)
    if info is None and must_exist:
        fail(f"Tool not found: {tool_id!r}. Installed tools: {', '.join(installed_ids()) or '(none)'}")
    return tool_id, info


def user_path_for(tool_id: str, category) -> Path:
    """Where a user copy of this tool belongs: same group layout, under the
    user tools dir."""
    return tools_dir() / category / tool_id if category else tools_dir() / tool_id


def ensure_user_copy(tool_id: str, info: dict) -> Path:
    """Copy-on-write: a native tool served from the bundle gets its folder
    copied (vendored deps included) into the user dir before any edit. The
    bundled original is never written; the 'reset' action deletes the copy."""
    if info["user_path"] is not None:
        return info["user_path"]
    dst = user_path_for(tool_id, info["category"])
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(
        info["native_path"], dst,
        ignore=shutil.ignore_patterns("__pycache__", "*.pyc"),
    )
    return dst


def as_object(value, field: str) -> dict:
    """Accept a JSON object, or a JSON string holding one (models often quote)."""
    if isinstance(value, str):
        try:
            value = json.loads(value)
        except json.JSONDecodeError as e:
            fail(f"'{field}' is not valid JSON: {e}")
    if not isinstance(value, dict):
        fail(f"'{field}' must be a JSON object.")
    return value


def do_list() -> None:
    # Plain text, one line per tool: the reader is a model, and a pretty JSON
    # dump costs tokens without adding information.
    lines = []
    for tool_id, info in sorted(catalogue().items()):
        meta = read_meta(info["path"]) or {}
        tags = [info["origin"]]  # 'native' ships with the app; editing makes a copy
        if info["category"]:
            tags.insert(0, info["category"])
        if info["has_override"]:
            tags.append("modified")  # see action='reset'
        if meta.get("internal"):
            tags.append("internal")
        if not meta.get("enabled", True):
            tags.append("DISABLED")
        params = ", ".join(sorted((meta.get("parameters") or {}).get("properties", {}).keys())) or "none"
        desc = " ".join((meta.get("description") or "").split())
        lines.append(f"- {tool_id} ({', '.join(tags)}) params: {params}"
                     + (f"\n  {desc}" if desc else ""))
    print(f"OK: {len(lines)} tool(s)")
    print("\n".join(lines))


def do_get(args: dict) -> None:
    tool_id, info = resolve(args, must_exist=True)
    path = info["path"]
    meta = read_meta(path) or {}
    run_path = path / "run"
    script = None
    if run_path.exists():
        try:
            script = run_path.read_text(errors="replace")
        except OSError as e:
            script = f"(cannot read run script: {e})"
    # Metadata as key: value lines; parameters as compact JSON (the model must
    # reproduce that schema verbatim on save); the script verbatim between
    # markers (needed whole for editing — save takes the full new script).
    print(f"OK: tool '{meta.get('name', tool_id)}' (id: {tool_id})")
    print(f"description: {meta.get('description', '')}")
    if info["category"]:
        print(f"category: {info['category']}")
    print(f"origin: {info['origin']}; modified: {info['has_override']}; "
          f"enabled: {meta.get('enabled', True)}; internal: {bool(meta.get('internal'))}")
    print(f"timeout: {meta.get('timeout', 30)}; max_output: {meta.get('max_output', 10000)}")
    print(f"parameters: {json.dumps(meta.get('parameters') or {}, ensure_ascii=False)}")
    if script is None:
        print("script: (none — this tool has no run script)")
    else:
        print("script (between the ---BEGIN/END SCRIPT--- markers):")
        print("---BEGIN SCRIPT---")
        print(script.rstrip("\n"))
        print("---END SCRIPT---")


def check_script(script: str) -> None:
    if not script.startswith("#!"):
        fail(
            "'script' must start with a shebang line, e.g. '#!/usr/bin/env python3', "
            "'#!/bin/bash' or '#!/usr/bin/env node'."
        )
    shebang = script.split("\n", 1)[0]
    # Catch syntax errors before the tool is ever called by an agent.
    if "python" in shebang:
        try:
            compile(script, "run", "exec")
        except SyntaxError as e:
            fail(f"Python syntax error in 'script' at line {e.lineno}: {e.msg}")


def do_save(args: dict) -> None:
    tool_id, info = resolve(args, must_exist=False)
    existed = info is not None

    if existed:
        meta = read_meta(info["path"])
        if meta is None:
            fail(f"Tool {tool_id!r} exists but its tool.json is unreadable — fix or delete it first.")
        if meta.get("internal"):
            fail(f"Tool {tool_id!r} is internal (handled in-process): it has no run script and cannot be edited here.")
        wanted = (args.get("category") or "").strip()
        if wanted and wanted != (info["category"] or ""):
            fail(
                f"Tool {tool_id!r} already lives in "
                f"{'group ' + info['category'] if info['category'] else 'the top level'}; "
                "moving it is not supported here."
            )
        # Copy-on-write: edits to a native tool land on a user copy; the
        # shipped original stays intact (action='reset' restores it).
        path = ensure_user_copy(tool_id, info)
    else:
        meta = dict(_META_DEFAULTS)
        # Creating from scratch: the model must at least say what it does and how.
        for required in ("name", "description", "script"):
            value = args.get(required)
            if not isinstance(value, str) or not value.strip():
                fail(f"Creating a new tool needs '{required}'. Provide name, description and script.")
        category = (args.get("category") or "").strip()
        if category:
            if not _VALID_TOOL_ID.match(category) or ".." in category:
                fail(f"Invalid category: {category!r}. Use letters, digits, '.', '_' or '-'.")
            if (tools_dir() / category / "tool.json").exists() or (
                (bundled_dir() or tools_dir()) / category / "tool.json"
            ).exists():
                fail(f"{category!r} is a tool, not a group — pick another category name.")
        path = user_path_for(tool_id, category or None)

    for key in ("name", "description"):
        if args.get(key) is not None:
            meta[key] = args[key]
    if args.get("parameters") is not None:
        params = as_object(args["parameters"], "parameters")
        if params.get("type") != "object" or not isinstance(params.get("properties"), dict):
            fail(
                "'parameters' must be a JSON Schema object like "
                '{"type": "object", "properties": {...}, "required": [...]}.'
            )
        meta["parameters"] = params
    for key in ("timeout", "max_output"):
        if args.get(key) is not None:
            v = args[key]
            if isinstance(v, bool) or not isinstance(v, int) or v < 1:
                fail(f"'{key}' must be a positive integer.")
            meta[key] = v
    if args.get("enabled") is not None:
        if not isinstance(args["enabled"], bool):
            fail("'enabled' must be true or false.")
        meta["enabled"] = args["enabled"]

    script = args.get("script")
    if script is not None:
        if not isinstance(script, str):
            fail("'script' must be a string containing the run script source.")
        check_script(script)

    for key, default in _META_DEFAULTS.items():
        meta.setdefault(key, default)

    path.mkdir(parents=True, exist_ok=True)

    # Write the script first: a tool.json without a working run is the failure
    # mode an agent would notice last.
    if script is not None:
        run_path = path / "run"
        tmp = path / "run.tmp"
        # Text files end with a newline: without it every later diff of this
        # file starts with a "\ No newline at end of file" hunk.
        tmp.write_text(script if script.endswith("\n") else script + "\n")
        os.chmod(tmp, 0o755)
        tmp.replace(run_path)

    tmp = path / "tool.json.tmp"
    tmp.write_text(json.dumps(meta, ensure_ascii=False, indent=2) + "\n")
    tmp.replace(path / "tool.json")

    verb = "Updated" if existed else "Created"
    print(f"OK: {verb} tool '{meta['name']}' (id: {tool_id}) in {path}")
    if not (path / "run").exists():
        print("WARNING: this tool has no 'run' script yet — it cannot be executed.")
    elif script is not None:
        # Saving proves nothing about the script working. Models tend to report
        # a successful test they never ran, so the next step is spelled out
        # here, in the text they read right before deciding what to do.
        print(
            f"NOT TESTED YET: the script was written but never executed. Do NOT tell the user it "
            f"works. Next call: {{\"name\": \"manage_tools\", \"arguments\": {{\"action\": \"test\", "
            f"\"id\": \"{tool_id}\", \"test_args\": {{...}}}}}}"
        )
    # Essentials only — the caller just sent this config, no need to echo it.
    print(f"params: {', '.join(sorted((meta.get('parameters') or {}).get('properties', {}).keys())) or 'none'}; "
          f"timeout: {meta.get('timeout', 30)}; enabled: {meta.get('enabled', True)}")


def do_test(args: dict) -> None:
    tool_id, info = resolve(args, must_exist=True)
    path = info["path"]
    meta = read_meta(path) or {}
    if meta.get("internal"):
        fail(f"Tool {tool_id!r} is internal and cannot be executed from here.")
    run_path = path / "run"
    if not run_path.exists():
        fail(f"Tool {tool_id!r} has no 'run' script.")
    if not run_path.stat().st_mode & 0o111:
        fail(f"Tool {tool_id!r}/run is not executable — re-save it with 'script' to fix the permissions.")

    test_args = args.get("test_args")
    test_args = as_object(test_args, "test_args") if test_args is not None else {}

    # Same execution context the registry gives a tool: workspace as cwd, plus
    # MYAGENT_WORKSPACE / MYAGENT_APP_DIR / MYAGENT_HOME / MYAGENT_LIBRARY /
    # MYAGENT_CACHE (inherited from the server env, which is where the registry
    # already put the RESOLVED values). This env must not drift from
    # ToolRegistry.execute: a tool that passes its test here and then behaves
    # differently in a real turn is the worst outcome this action can produce.
    ws = workspace_dir()
    env = {**os.environ}
    cwd = path
    try:
        ws.mkdir(parents=True, exist_ok=True)
        cwd = ws
        env["MYAGENT_WORKSPACE"] = str(ws)
    except OSError:
        pass

    timeout = meta.get("timeout", 30)
    if not isinstance(timeout, int) or timeout < 1:
        timeout = 30
    timeout = min(timeout, _MAX_TEST_SECONDS)

    try:
        proc = subprocess.run(
            [str(run_path)],
            input=json.dumps(test_args),
            capture_output=True,
            text=True,
            cwd=str(cwd),
            env=env,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        fail(f"Tool {tool_id!r} timed out after {timeout}s.")
    except OSError as e:
        fail(f"Cannot execute tool {tool_id!r}: {e} (check the shebang line).")

    status = "OK: test passed" if proc.returncode == 0 else f"ERROR: test failed (exit {proc.returncode})"
    print(f"{status} for tool '{tool_id}' with args {json.dumps(test_args, ensure_ascii=False)}")
    print(f"stdout:\n{proc.stdout[:4000] or '(empty)'}")
    if proc.stderr:
        print(f"stderr:\n{proc.stderr[:2000]}")
    # Exit 0 either way: a failing test is a result to reason about, not a
    # broken tool call — the agent needs stdout/stderr to fix the script.


def _remove_user_copy(path: Path) -> None:
    shutil.rmtree(path)
    # Don't leave an empty group folder behind as a phantom category.
    if path.parent != tools_dir():
        try:
            path.parent.rmdir()
        except OSError:
            pass


def do_delete(args: dict) -> None:
    tool_id, info = resolve(args, must_exist=True)
    if tool_id == _SELF_ID:
        fail(f"Refusing to delete {_SELF_ID!r}: it is the tool used to manage tools.")
    meta = read_meta(info["path"]) or {}
    if meta.get("internal"):
        fail(f"Tool {tool_id!r} is internal and cannot be deleted.")
    if info["origin"] == "native":
        fail(
            f"Tool {tool_id!r} ships with the app and cannot be deleted. "
            "Use action='reset' to discard local changes, or save it with "
            "enabled=false to hide it from agents."
        )
    try:
        _remove_user_copy(info["user_path"])
    except OSError as e:
        fail(f"Cannot delete tool {tool_id!r}: {e}")
    print(f"OK: Deleted tool '{tool_id}' ({info['user_path']})")


def do_reset(args: dict) -> None:
    """Discard the local copy of a native tool: the shipped original shows
    through again immediately."""
    tool_id, info = resolve(args, must_exist=True)
    if info["origin"] != "native":
        fail(f"Tool {tool_id!r} is not a native tool — use action='delete' instead.")
    if info["user_path"] is None:
        fail(f"Tool {tool_id!r} has no local copy: it is already the original version.")
    try:
        _remove_user_copy(info["user_path"])
    except OSError as e:
        fail(f"Cannot reset tool {tool_id!r}: {e}")
    print(f"OK: Reset tool '{tool_id}' to the shipped version ({info['native_path']}).")


def main() -> None:
    try:
        args = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError as e:
        fail(f"Invalid JSON input: {e}")
    if not isinstance(args, dict):
        fail("Input must be a JSON object.")

    action = (args.get("action") or "").strip().lower()
    if action == "list":
        do_list()
    elif action in ("get", "read", "show"):
        do_get(args)
    elif action in ("save", "add", "create", "update", "upsert"):
        do_save(args)
    elif action in ("test", "run"):
        do_test(args)
    elif action in ("delete", "remove"):
        do_delete(args)
    elif action in ("reset", "restore"):
        do_reset(args)
    else:
        fail("Unknown action. Use 'list', 'get', 'save', 'test', 'reset' or 'delete'.")


if __name__ == "__main__":
    main()
