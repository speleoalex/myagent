# Sample systemd unit for the MyAgent Connectors server.
#
# User unit (recommended, no root):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/myagent-connectors.service ~/.config/systemd/user/
#   # edit paths/env below to match your install, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now myagent-connectors
#   journalctl --user -u myagent-connectors -f
#
# (For an always-on user service on a headless box, also run:
#   sudo loginctl enable-linger $USER )

[Unit]
Description=MyAgent Connectors (messaging bridge)
# If myagent runs on the same host as a user service, order after it:
# After=myagent.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Point these at your clone of the repository:
WorkingDirectory=/path/to/myagent/connectors
ExecStart=/path/to/myagent/connectors/.venv/bin/python server/main.py
Environment=MYAGENT_API_URL=http://localhost:8888
Environment=MYAGENT_CONNECTORS_HOST=127.0.0.1
Environment=MYAGENT_CONNECTORS_PORT=8899
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
